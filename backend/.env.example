PORT=5000
NODE_ENV=development
JWT_SECRET=careerpilot_super_secret_jwt_key_2026

# Optional: PostgreSQL Database URL (if omitted, automatically falls back to local SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/careerpilot

# Optional: Google OAuth 2.0 Client ID (1-Click Demo mode works out-of-the-box without this)
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Optional: Gemini API Key (multilingual fallback works out-of-the-box without this)
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Resend API Key for live email delivery (simulated preview works out-of-the-box)
# RESEND_API_KEY=re_123456789
EMAIL_FROM="CareerPilot AI <notifications@careerpilot.ai>"
